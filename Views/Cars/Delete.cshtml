@model WtLab3Mvc.Models.Car
@{ ViewData["Title"] = "Удалить"; }

<h1>Удалить автомобиль?</h1>

<dl class="row">
    <dt class="col-sm-3">Марка</dt>
    <dd class="col-sm-9">@Model.Brand</dd>
    <dt class="col-sm-3">Модель</dt>
    <dd class="col-sm-9">@Model.Model</dd>
    <dt class="col-sm-3">Цена/день</dt>
    <dd class="col-sm-9">@Model.PricePerDay.ToString("C")</dd>
</dl>

<form asp-action="Delete" method="post">
    <input type="hidden" name="id" value="@Model.Id" />
    <button type="submit" class="btn btn-danger">Удалить</button>
    <a asp-action="Index" class="btn btn-secondary">Отмена</a>
</form>