@page "/razor/cars/delete/{id:int}"
@model WtLab3Mvc.Pages.Cars.DeleteModel
@{ ViewData["Title"] = "Удалить (Razor)"; }

<h1>Удалить? (Razor Pages)</h1>

@if (Model.Car != null)
{
    <dl class="row">
        <dt class="col-sm-3">Марка</dt>
        <dd class="col-sm-9">@Model.Car.Brand</dd>
        <dt class="col-sm-3">Модель</dt>
        <dd class="col-sm-9">@Model.Car.Model</dd>
    </dl>

    <form method="post">
        <input type="hidden" name="id" value="@Model.Car.Id" />
        <button type="submit" class="btn btn-danger">Удалить</button>
        <a asp-page="Index" class="btn btn-secondary">Отмена</a>
    </form>
}